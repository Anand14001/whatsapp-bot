# Copy to .env and fill in. Never commit .env.

# ---- Evolution API ----
# Locally: http://localhost:8081 · In docker compose: http://evolution-api:8080
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=same_value_as_AUTHENTICATION_API_KEY_in_docker_compose
EVOLUTION_INSTANCE=digital-dude

# Sits in the webhook URL path so only Evolution can POST to this bot.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=pick-any-long-random-string-you-invent

# ---- Lead dashboard ----
DASHBOARD_TOKEN=another-long-random-string
DATA_DIR=data

# ---- LLM ----
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.8-flash

# ---- Sales team escalation (comma separated, country code, no + or spaces) ----
# Never put the bot's own number here — a number cannot message itself.
SALES_TEAM_NUMBERS=919787097006,918939651525

# ---- Server ----
PORT=8080

# ---- Safety rails ----
# Outbound cap. Unofficial numbers get banned for bursts, so keep this low.
MAX_MESSAGES_PER_MINUTE=20
CONNECTION_CHECK_MS=120000
